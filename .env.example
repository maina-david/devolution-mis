APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Use an approved tile provider or self-hosted tiles in production.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILE_ATTRIBUTION='&copy; OpenStreetMap contributors'
PASSPORT_CLIENT_CREDENTIALS_TOKEN_TTL_MINUTES=15
INTEGRATION_RETRY_SERVICE_USER_EMAIL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=devolution_mis
DB_USERNAME=postgres
DB_PASSWORD=
DB_TIMEZONE=+00:00

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
ANALYTICS_REPORT_DISK=local
ANALYTICS_MINIMUM_AGGREGATE_CELL_SIZE=5
QUEUE_CONNECTION=database
QUEUE_OLDEST_AGE_WARNING_SECONDS=300
FAILED_JOBS_WARNING=0
DB_QUEUE_RETRY_AFTER=2100
REDIS_QUEUE_RETRY_AFTER=2100
DOCUMENT_PDFTOTEXT_BINARY=pdftotext
DOCUMENT_PDFTOPPM_BINARY=pdftoppm
DOCUMENT_TESSERACT_BINARY=tesseract
DOCUMENT_OCR_LANGUAGE=eng
DOCUMENT_OCR_PDF_DPI=200
DOCUMENT_OCR_PDF_MAX_PAGES=250
DOCUMENT_EXTRACTION_TIMEOUT=120
DOCUMENT_EXTRACTION_MAX_CHARACTERS=2000000
DOCUMENT_EXTRACTION_RETRY_MINUTES=30

# Provisional M&E follow-up targets. Programme-owner approval is required for production values.
EVALUATION_FINDING_REMINDER_DAYS=7
EVALUATION_FINDING_ESCALATION_PERMISSION=indicators:manage

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Operations and recovery targets. Production values require owner approval.
SERVICE_NAME=idmis-web
BACKUP_DISK=local
BACKUP_PATH=operations/backups
BACKUP_RETENTION_DAYS=35
RPO_MINUTES=60
RTO_MINUTES=240
AVAILABILITY_TARGET_PERCENT=99.5
READINESS_LATENCY_TARGET_MS=1000
QUEUE_DEPTH_WARNING=1000
BACKUP_MAX_AGE_MINUTES=1440
PG_DUMP_BINARY=pg_dump
PG_RESTORE_BINARY=pg_restore
CREATEDB_BINARY=createdb
DROPDB_BINARY=dropdb
PSQL_BINARY=psql
OPERATIONS_PERFORMANCE_BASE_URL=https://devolution-mis.test
OPERATIONS_PERFORMANCE_ALLOWED_HOSTS=devolution-mis.test
OPERATIONS_PERFORMANCE_BINARY=/usr/sbin/ab
OPERATIONS_PERFORMANCE_MAX_REQUESTS=10000
OPERATIONS_PERFORMANCE_MAX_CONCURRENCY=100
OPERATIONS_PERFORMANCE_TIMEOUT_SECONDS=120
OPERATIONS_PERFORMANCE_MIN_RPS=10
OPERATIONS_PERFORMANCE_MAX_P95_MS=1000
OPERATIONS_PERFORMANCE_MAX_FAILURES=0

# Provisional privacy workflow targets. DPO approval is required for production values.
PRIVACY_DSR_TARGET_DAYS=30
PRIVACY_PROCESSING_REVIEW_MONTHS=12

# Security governance targets. Production cadence requires security-owner approval.
ACCESS_REVIEW_DUE_DAYS=21
THREAT_REVIEW_MONTHS=6
SECURITY_SBOM_DISK=local
SECURITY_SBOM_PATH=security/sbom
SECURITY_SCAN_TIMEOUT_SECONDS=120
SECURITY_INCIDENT_REMINDER_MINUTES=15
IDENTITY_LIFECYCLE_SERVICE_USER_EMAIL=
IDENTITY_LIFECYCLE_MAX_APPLICATION_ATTEMPTS=5
AUDIT_ASSURANCE_DISK=local
AUDIT_ASSURANCE_PATH=audit/assurance
AUDIT_ASSURANCE_ACTIVE_KEY=
AUDIT_ASSURANCE_SIGNING_KEYS={}

# Provisional partner-control windows. Accountable programme-owner approval is required for production values.
PARTNER_AGREEMENT_EXPIRY_NOTICE_DAYS=60
PARTNER_CONTRIBUTION_RECONCILIATION_DUE_DAYS=30
PARTNER_CONTRIBUTION_EXCHANGE_LOOKBACK_DAYS=7
PARTNER_RECONCILIATION_SERVICE_USER_EMAIL=
PARTNER_COLLABORATION_ACTION_REMINDER_DAYS=7

# Production integrations remain disabled until approved and provisioned.
INTEGRATION_ALLOWED_HOSTS=
IFMIS_API_TOKEN=
IPPD_API_TOKEN=
OCOB_API_TOKEN=
CBK_API_TOKEN=
